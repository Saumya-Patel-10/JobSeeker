# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="JobAIgent"
APP_ENV=development          # development | production
SECRET_KEY=changeme-super-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobaigent_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/jobaigent_db

# ── Redis (Celery broker + result backend) ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── AWS S3 (resume / cover letter storage) ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=jobaigent-resumes

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_BASIC=price_...     # $3.99 / month
STRIPE_PRICE_ID_PRO=price_...       # $7.99 / month

# ── Job Board Credentials (for scraping) ─────────────────────────────────────
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
INDEED_EMAIL=
INDEED_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email (notifications) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@jobaigent.com
