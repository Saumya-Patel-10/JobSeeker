{
  "name": "jobseeker",
  "version": "1.1.0",
  "private": true,
  "description": "AI-powered job discovery and application platform.",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev/dev.mjs",
    "backend": "node scripts/dev/backend.mjs",
    "frontend": "node scripts/dev/frontend.mjs",
    "doctor": "node scripts/dev/doctor.mjs",
    "install": "node scripts/dev/install.mjs",
    "bootstrap": "node scripts/dev/bootstrap.mjs",
    "lint": "node scripts/dev/lint.mjs",
    "test": "node scripts/dev/test.mjs",
    "build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "format": "prettier --write \"**/*.{json,md,tsx,ts,js,mjs,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
