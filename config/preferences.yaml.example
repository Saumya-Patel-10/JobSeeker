# Job Finding Assistant - preferences TEMPLATE.
# On first run the app copies this to config/preferences.yaml (git-ignored).
# Edit that file for your own search; the Control Center UI also writes to it.

llm:
  provider: lmstudio
  base_url: http://localhost:1234/v1
  api_key: lm-studio
  chat_model: google/gemma-4-12b-qat
  embedding_model: null
  request_timeout: 120.0
  max_retries: 3
  temperature: 0.2
browser:
  engine: firefox
  persistent_profile: true
  profile_source: managed
  firefox_profile: null
  headless: false
  slowmo_ms: 50
  profile: default
  reuse_existing_session: true
  clone_system_profile_on_lock: true
  locale: en-US
  user_agent: null
  timeout_ms: 30000
  viewport_width: 1366
  viewport_height: 900
apply:
  default_mode: human_review
  allow_auto_submit: false
  daily_limit: 20
  require_min_score: 0.6
  confirm_before_submit: true
automation:
  max_concurrent_sessions: 1
  cooldown_seconds: 90
  default_interval_minutes: 30
scoring:
  weights:
    skill_overlap: 0.35
    seniority_alignment: 0.15
    salary_fit: 0.10
    location_compatibility: 0.15
    fit_score: 0.20
seniority: null
locations:
- Remote (US)
- Anywhere
role_keywords:
- software engineer
- software developer
- frontend engineer
- frontend developer
- backend engineer
- backend developer
- full stack engineer
- full stack developer
- fullstack
- ai engineer
- ai developer
- machine learning engineer
- ml engineer
- artificial intelligence
- web developer
- python developer
- react developer
- distributed systems
- cloud engineer
- platform engineer
- devops
excluded_keywords:
- unpaid
- commission only
excluded_titles:
- staff augmentation
- contractor only
preferred_industries: []
target_companies: []
remote_preference: no_preference
salary_expectations:
  min: null
  max: null
  currency: USD
  period: year
