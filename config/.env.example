# Copy to `.env` (in the project root) and edit. None of these are required —
# YAML configs override most defaults — but they're handy for one-off tweaks
# without rewriting YAML.

# Path overrides (rarely needed)
# JOBASSIST_ROOT=

# Logging
JOBASSIST_LOG_LEVEL=INFO

# LM Studio / Ollama URLs (optional overrides; YAML wins if both set)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# OLLAMA_BASE_URL=http://localhost:11434

# LinkedIn cookies / credentials are NOT stored here. The Playwright
# persistent profile in data/browser_profiles/ handles your session.
